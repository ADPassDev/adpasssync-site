{
  "name": "adpasssync-site",
  "version": "0.1.0",
  "private": true,
  "description": "ADPassSync marketing site and customer portal Worker",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "test:dev": "bash test/downloads-dev.sh",
    "db:apply:local": "wrangler d1 execute adpasssync-db --local --file=./schema.sql",
    "db:apply:remote": "wrangler d1 execute adpasssync-db --remote --file=./schema.sql",
    "keys:generate": "node --experimental-strip-types scripts/generate-keys.ts",
    "db:migrate:local": "wrangler d1 migrations apply adpasssync-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply adpasssync-db --remote"
  },
  "dependencies": {
    "hono": "^4.13.20"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.166.0"
  }
}
